# For LAN/VPN access. Use HTTPS when exposed outside a trusted network.
POSTGRES_DB=modelboard
POSTGRES_USER=modelboard
# New database: use a random hex password. Existing volume: keep its current password.
POSTGRES_PASSWORD=
# Generate independently, e.g. openssl rand -hex 32
JWT_SECRET=
WEB_BIND_ADDRESS=0.0.0.0
WEB_PORT=8080
# Replace with the address participants will open.
WEB_ORIGIN=http://192.168.1.50:8080

# Login: owner@example.local. At least 12 characters; no default password.
OWNER_PASSWORD=
# Optional accounts. Empty password disables login for that account.
# editor@example.local / commenter@example.local / viewer@example.local
EDITOR_PASSWORD=
COMMENTER_PASSWORD=
VIEWER_PASSWORD=
