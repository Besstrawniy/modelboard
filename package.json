{
  "name": "modelboard",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node --env-file-if-exists=.env --run dev:services",
    "dev:web": "npm run dev --workspace @modelboard/web",
    "dev:api": "npm run dev --workspace @modelboard/api",
    "dev:collab": "npm run dev --workspace @modelboard/collab",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "node --experimental-transform-types --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "pretest:e2e": "node --env-file-if-exists=.env --import tsx scripts/prepare-e2e.mts",
    "music:scan": "node scripts/music-manifest.mjs",
    "predev:web": "npm run music:scan",
    "prebuild": "npm run music:scan",
    "dev:services": "concurrently -k -n web,api,collab \"npm:dev:web\" \"npm:dev:api\" \"npm:dev:collab\"",
    "test:server": "playwright test --config playwright.server.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "concurrently": "^9.0.0"
  }
}
